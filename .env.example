# =============================================================================
#  AI crypto trading system — configuration template
#
#  cp .env.example .env      then edit .env (which is git-ignored)
#
#  Every default here is the SAFE one. The system runs in paper mode, does not
#  need any exchange credentials, and will refuse to touch real money until
#  three separate switches are set (bottom of this file).
#
#  NEVER commit a filled-in .env. NEVER paste exchange keys into n8n workflow
#  JSON — n8n has a credential store for that (see n8n/credentials-docs/).
# =============================================================================

# ------------------------------------------------------------------ service
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | console
API_PORT=8000

# Shared secret n8n sends as the X-API-Key header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# REQUIRED when ENVIRONMENT=production. The dashboard also accepts it as ?key=
SERVICE_API_KEY=

# ------------------------------------------------------------------ database
POSTGRES_USER=trader
POSTGRES_PASSWORD=change-me-in-your-env
POSTGRES_DB=trading
POSTGRES_PORT=5432
# Overridden by docker-compose for the container; set this for local runs:
# DATABASE_URL=postgresql+psycopg://trader:trader@localhost:5432/trading

# Optional cache. Leave empty to run without Redis (Postgres is the record).
REDIS_URL=
REDIS_PORT=6379

# ---------------------------------------------------------------------- n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-in-your-env
# Required. Keep it stable or stored credentials become unreadable:
#   python -c "import secrets; print(secrets.token_hex(24))"
N8N_ENCRYPTION_KEY=
TZ=UTC

# ------------------------------------------------------------------- market
TRADING_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAMES=5m,15m,1h,4h
PRIMARY_TIMEFRAME=1h
QUOTE_CURRENCY=USDT

EXCHANGE_ID=binance
MARKET_DATA_PROVIDER=ccxt       # ccxt (real public data) | synthetic (offline fixture)
MARKET_DATA_TIMEOUT_SECONDS=15

# Data-quality gates. Failing any of these means NO TRADE.
MAX_DATA_STALENESS_SECONDS=300
MIN_CANDLES_FOR_ANALYSIS=120
MAX_CANDLE_GAP_RATIO=0.02

# -------------------------------------------------------------- paper engine
PAPER_STARTING_BALANCE=10000
PAPER_TAKER_FEE_BPS=10          # 10 bps = 0.10%
PAPER_MAKER_FEE_BPS=8
PAPER_SLIPPAGE_BPS=5
PAPER_SPREAD_BPS=4
PAPER_PARTIAL_FILL_PROBABILITY=0.0

# --------------------------------------------------------------- benchmarks
# The yield idle capital gives up to be traded. Cash at 0% is the wrong floor:
# USDT lends on every major venue, so a strategy returning less than this has
# lost money for the risk it took. Kept conservative on purpose -- a low bar is
# the generous reading, so failing to clear it is decisive.
# NOT risk-free: CeFi lending carries counterparty risk, stablecoins depeg risk.
BENCHMARK_YIELD_APY=0.04

# --------------------------------------------------------------------- risk
# RISK_PER_TRADE is the fraction of equity intentionally lost if the stop is hit.
# It is NOT the position size. 0.005 = 0.5% of equity risked per trade.
RISK_PER_TRADE=0.005
MAX_POSITION_PCT_EQUITY=0.20    # cap on one position's notional
MAX_PORTFOLIO_EXPOSURE_PCT=0.50 # cap on total notional across positions
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_DAILY_LOSS_PCT=0.02         # halts new entries for the day
MAX_DRAWDOWN_PCT=0.10           # trips the kill switch
CONSECUTIVE_LOSS_LIMIT=3
COOLDOWN_MINUTES=120
MIN_CONFIDENCE=0.60
MIN_RISK_REWARD=1.5
MAX_SPREAD_BPS=15
MIN_24H_QUOTE_VOLUME=5000000
REQUIRE_STOP_LOSS=true
MIN_STOP_DISTANCE_PCT=0.003
MAX_STOP_DISTANCE_PCT=0.15
ABNORMAL_PRICE_MOVE_PCT=0.10
RISK_APPROVAL_TTL_SECONDS=120   # how long a risk approval stays usable
MAX_LEVERAGE=1                  # spot only; must stay 1

# ---------------------------------------------------------------- AI / LLM
AI_ENABLED=true
LLM_PROVIDER=ollama             # ollama | openai | anthropic | disabled
LLM_MODEL=qwen2.5-coder:7b
# Leave empty to use each provider's own default endpoint.
#   ollama (host):   http://host.docker.internal:11434
#   openai:          https://api.openai.com
#   anthropic:       https://api.anthropic.com
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_CALLS_PER_HOUR=60
AI_MIN_MINUTES_BETWEEN_CALLS_PER_SYMBOL=15
# The AI can only confirm or veto a setup the quant layer already built.
AI_VETO_ONLY=true
# When the AI layer is unavailable, refuse the entry rather than trade without it.
AI_REQUIRED_FOR_ENTRY=true

# Only needed for the matching provider. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Suggested models: openai -> gpt-4o-mini ; anthropic -> claude-sonnet-5

# --------------------------------------------------------------- strategies
ENABLED_STRATEGIES=trend_following,ema_momentum,breakout,mean_reversion,volatility_breakout

# =============================================================================
#  LIVE TRADING — DISABLED. Leave it that way until the checklist is complete.
#
#  docs/LIVE_TRADING_CHECKLIST.md lists what must be true first. All three of
#  these, plus valid credentials, are required; any one missing and the service
#  silently stays in paper mode (and says so in /health).
# =============================================================================
TRADING_MODE=paper              # paper | live
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=      # must be exactly: I_UNDERSTAND_REAL_MONEY_IS_AT_RISK

# Exchange credentials. Use trade-only keys with withdrawals DISABLED and an IP
# allowlist. Adding keys here does NOT enable live trading on its own.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=
